<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_stock_restriction" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.restriction</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Sales Settings: Insert after 'Product Catalog' block -->
                <xpath expr="//block[@name='catalog_setting_container']" position="after">
                    <block title="Stock Restrictions" id="stock_restriction_sale_setting" app="sale">
                        <setting id="restrict_zero_stock_sale" help="Prevents adding products with zero or negative stock to sales orders.">
                            <field name="restrict_zero_sale"/>
                        </setting>
                        <setting id="restrict_zero_stock_sale" help="Prevents adding products with zero or negative stock to sales orders.">
                            <field name="restrict_zero_sale"/>
                        </setting>
                        <setting id="stock_validation_policy_sale" help="Defines if the restriction applies to all products or respects the invoicing policy.">
                            <field name="stock_validation_policy" widget="radio"/>
                        </setting>
                    </block>
                </xpath>

                <!-- Invoicing Settings: Insert after 'Customer Invoices' block -->
                 <xpath expr="//block[@id='invoicing_settings']" position="after">
                    <block title="Stock Restrictions" id="stock_restriction_account_setting" app="account">
                        <setting id="restrict_zero_stock_invoice" help="Prevents adding products with zero or negative stock to customer invoices.">
                            <field name="restrict_zero_invoice"/>
                        </setting>
                        <setting id="restrict_zero_stock_invoice" help="Prevents adding products with zero or negative stock to customer invoices.">
                            <field name="restrict_zero_invoice"/>
                        </setting>
                        <setting id="stock_validation_policy_account" help="Defines if the restriction applies to all products or respects the invoicing policy.">
                            <field name="stock_validation_policy" widget="radio"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
