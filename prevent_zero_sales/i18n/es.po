#. module: prevent_zero_sales
#. odoo-python
#: code:addons/prevent_zero_sales/models/account_move.py:0
#: code:addons/prevent_zero_sales/models/sale_order.py:0
msgid ""
"Active Restriction: Not enough stock for product %(product)s. (Requested: "
"%(requested)s, Available: %(available)s)"
msgstr ""
"Restricción Activa: No hay stock suficiente para el producto %(product)s. "
"(Solicitado: %(requested)s, Disponible: %(available)s)"

#. module: prevent_zero_sales
#. odoo-javascript
#: code:addons/prevent_zero_sales/static/src/js/stock_restricted_list_renderer.js:0
#: code:addons/prevent_zero_sales/static/src/xml/stock_restricted_list_renderer.xml:0
msgid ""
"Adding products with zero or insufficient stock is not allowed. Please fix "
"the existing lines."
msgstr ""
"No se permite agregar productos con stock cero o insuficiente. Por favor "
"corrija las líneas existentes."

#. module: prevent_zero_sales
#: model:ir.model.fields,help:prevent_zero_sales.field_res_company__restrict_zero_sale
#: model:ir.model.fields,help:prevent_zero_sales.field_res_config_settings__restrict_zero_sale
msgid ""
"Block confirmation of sales orders containing lines with zero or negative "
"quantity/price, or with insufficient forecasted stock."
msgstr ""
"Bloquea la confirmación de pedidos de venta que contengan líneas con "
"cantidad/precio cero o negativo, o con stock previsto insuficiente."

#. module: prevent_zero_sales
#: model:ir.model.fields,help:prevent_zero_sales.field_res_company__restrict_zero_invoice
#: model:ir.model.fields,help:prevent_zero_sales.field_res_config_settings__restrict_zero_invoice
msgid ""
"Block posting of customer invoices containing lines with zero or negative "
"quantity/price, or with insufficient forecasted stock."
msgstr ""
"Bloquea la publicación de facturas de cliente que contengan líneas con "
"cantidad/precio cero o negativo, o con stock previsto insuficiente."

#. module: prevent_zero_sales
#. odoo-python
#: code:addons/prevent_zero_sales/models/account_move.py:0
