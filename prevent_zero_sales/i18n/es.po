#. module: prevent_zero_sales
#: model:ir.model.fields,help:prevent_zero_sales.field_res_company__strict_stock_validation
#: model:ir.model.fields,help:prevent_zero_sales.field_res_config_settings__strict_stock_validation
msgid ""
"If checked, stock restrictions apply regardless of the product invoicing "
"policy. If unchecked, products invoiced on delivered quantities are not "
"restricted."
msgstr ""
"Si está marcado, las restricciones de stock se aplican sin importar la "
"política de facturación del producto. Si no está marcado, los productos "
"facturados por cantidades entregadas no se restringen."

