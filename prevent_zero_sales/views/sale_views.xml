<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extension to Sale Order Form View -->
        <record id="view_order_form_inherit_stock_indicator_custom" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.stock.indicator.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- 0. Add Blocking Banner at the top of the order lines page -->
                <!-- We insert it before the field 'order_line' itself -->
                <xpath expr="//field[@name='order_line']" position="before">
                    <field name="stock_warning_banner" nolabel="1" colspan="2"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                    <field name="qty_on_hand_check" column_invisible="True"/>
                </xpath>

                <!-- Resaltar en rojo las líneas de productos sin stock disponible -->
                <xpath expr="//field[@name='order_line']/list" position="attributes">
                    <attribute name="decoration-danger">product_id and qty_on_hand_check &lt;= 0</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="widget">stock_restricted_section_and_note_one2many</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
