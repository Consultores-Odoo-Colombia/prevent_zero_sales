<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pzs_zero_stock_wizard_form" model="ir.ui.view">
        <field name="name">pzs.zero.stock.wizard.form</field>
        <field name="model">pzs.zero.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Products Without Stock">
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="product_names" nolabel="1" readonly="1"/>
                </group>
                <field name="res_model" invisible="1"/>
                <field name="res_ids_str" invisible="1"/>
                <footer>
                    <button name="action_confirm_remove" type="object"
                            string="Yes, remove and confirm" class="btn-primary"/>
                    <button special="cancel" string="No" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
